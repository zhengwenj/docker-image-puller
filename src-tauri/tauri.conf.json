{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docker Image Puller",
  "version": "1.0.0",
  "identifier": "io.github.zhengwenj.docker-image-puller",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Docker Image Puller - 镜像离线下载工具",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#F3F5F9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
